rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in player (anonymous sign-in) can see and play tables.
    match /games/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && gameId.size() == 4 && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }
  }
}
